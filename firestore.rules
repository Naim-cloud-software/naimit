rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Naimit speelt zonder login: alleen spel-data is open, verwijderen kan niet.
    match /games/{pin} {
      allow read, create, update: if true;
      match /{sub=**} { allow read, create, update: if true; }
    }
    match /artifacts/{a}/{rest=**} { allow read, write: if request.auth != null; }
    match /{other=**} { allow read, write: if false; }
  }
}
